# Copy this file to ".env" (same folder) and fill in your own values.
# .env is ignored by git, so your password never gets uploaded to GitHub.

# --- MySQL connection ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=fintrace

# --- Flask ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
