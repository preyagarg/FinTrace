# Copy to .env and edit:  cp .env.example .env
# Public domain. Point its DNS A record at this server for automatic HTTPS.
# "localhost" uses Caddy's internal CA (browser warning unless you trust it).
DOMAIN=localhost

# MySQL root password (only used inside the db container).
MYSQL_ROOT_PASSWORD=change-me-root

# Keep MYSQL_DATABASE=fintrace: database/schema.sql hardcodes this name.
MYSQL_DATABASE=fintrace
MYSQL_USER=fintrace
MYSQL_PASSWORD=change-me

# Flask session key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
