# Copy to .env and edit:  cp .env.example .env
# Public domain. Point its DNS A record at this server for automatic HTTPS.
# "localhost" uses Caddy's internal CA (browser warning unless you trust it).
DOMAIN=localhost

# Amazon RDS for MySQL 8.0 connection.
# Endpoint from RDS console > Databases > <instance> > Connectivity & security.
MYSQL_HOST=fintrace-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=change-me
# Keep MYSQL_DB=fintrace: database/schema.sql hardcodes this name.
MYSQL_DB=fintrace
# TLS to RDS uses the CA bundle baked into the image. Uncomment (empty) to disable TLS.
# MYSQL_SSL_CA=

# Flask session key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
